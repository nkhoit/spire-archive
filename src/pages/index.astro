---
import Layout from '../components/Layout.astro';
import { getData } from '../lib/data';
import { getLocale } from '../lib/i18n';
import { t } from '../lib/ui-strings';

const { locale, langPrefix } = getLocale(Astro);
const volumes = await Promise.all((['sts1', 'sts2'] as const).map(async (game, index) => {
  const data = await getData(game, locale);
  return {
    game,
    number: String(index + 1).padStart(2, '0'),
    title: game === 'sts1' ? 'Slay the Spire' : 'Slay the Spire 2',
    image: game === 'sts1' ? '/images/sts1/banner_sm.jpg' : '/images/sts2/landing.jpg',
    sections: [
      { path: 'cards', label: 'Cards', count: data.cards.length },
      { path: 'relics', label: 'Relics', count: data.relics.length },
      { path: 'potions', label: 'Potions', count: data.potions.length },
      { path: 'characters', label: 'Characters', count: data.characters.length },
    ],
  };
}));
---
<Layout title="Spire Archive" description="Slay the Spire companion — browse cards, relics, and more for STS1 and STS2.">
  <div class="archive-masthead">
    <div>
      <p class="editorial-label">{t('Reference', locale)} / I & II</p>
      <h1>Spire Archive<span aria-hidden="true">.</span></h1>
    </div>
    <p class="archive-intro">{t('a Slay the Spire companion', locale)}</p>
  </div>

  <div class="volume-index">
    {volumes.map((volume) => (
      <section class="volume-entry" aria-labelledby={`title-${volume.game}`}>
        <span class="volume-number" aria-hidden="true">{volume.number}</span>
        <a class="volume-image" href={`${langPrefix}/${volume.game}/`} tabindex="-1" aria-hidden="true">
          <img src={volume.image} alt="" width="800" height="450" />
        </a>
        <div class="volume-heading">
          <p class="editorial-label">{volume.game.toUpperCase()}</p>
          <h2 id={`title-${volume.game}`}><a href={`${langPrefix}/${volume.game}/`}>{volume.title}<span class="link-arrow" aria-hidden="true">→</span></a></h2>
        </div>
        <nav class="volume-quicklinks" aria-label={`${volume.title} — ${t('Browse', locale)}`}>
          {volume.sections.map((section) => (
            <a href={`${langPrefix}/${volume.game}/${section.path}`}>
              <span>{t(section.label, locale)}</span>
              <span class="index-count">{section.count.toLocaleString(locale)}</span>
            </a>
          ))}
        </nav>
        <a class="volume-browse" href={`${langPrefix}/${volume.game}/`}>{t('Browse', locale)} <span aria-hidden="true">→</span></a>
      </section>
    ))}
  </div>
</Layout>
