---
import Layout from '../../components/Layout.astro';
import { getData } from '../../lib/data';
import { getLocale } from '../../lib/i18n';
import { t } from '../../lib/ui-strings';
import { getPageGame } from '../../lib/page-game';

const game = getPageGame(Astro.params);
if (!game) return new Response('Not found', { status: 404 });

const { locale, langPrefix } = getLocale(Astro);
const data = await getData(game, locale);
const isSts2 = game === 'sts2';
const gameTitle = isSts2 ? 'Slay the Spire 2' : 'Slay the Spire';
const taglineMap: Record<string, string> = {
  IRONCLAD: t('Strength & self-healing', locale),
  THE_SILENT: t('Poison & card draw', locale),
  SILENT: t('Poison & card draw', locale),
  DEFECT: t('Orbs & channeling', locale),
  WATCHER: t('Stances & divine wrath', locale),
  NECROBINDER: t('Summons & sacrifice', locale),
  REGENT: t('Stars & burst turns', locale),
};
const portraitMap: Record<string, string> = {
  IRONCLAD: 'ironclad', THE_SILENT: 'silent', SILENT: 'silent', DEFECT: 'defect',
  WATCHER: 'watcher', NECROBINDER: 'necrobinder', REGENT: 'regent',
};
const positionMap: Record<string, string> = {
  IRONCLAD: isSts2 ? 'right center' : 'center 35%',
  THE_SILENT: 'center 40%', SILENT: 'right center',
  DEFECT: isSts2 ? 'right center' : 'center 25%',
  WATCHER: 'center 30%', NECROBINDER: 'right center', REGENT: 'right center',
};
const browseLinks = [
  { path: 'cards', label: 'Cards', count: data.cards.length },
  { path: 'relics', label: 'Relics', count: data.relics.length },
  { path: 'potions', label: 'Potions', count: data.potions.length },
  { path: 'monsters', label: 'Monsters', count: data.monsters.length },
  { path: 'events', label: 'Events', count: data.events.length },
  { path: 'effects', label: 'Buffs & Debuffs', count: data.powers.length },
  ...(isSts2 ? [{ path: 'enchantments', label: 'Enchantments', count: data.enchantments.length }] : []),
  { path: 'keywords', label: 'Game Mechanics', count: data.keywords.length },
];
---
<Layout game={game} title={`${gameTitle} — Spire Archive`} description={`The database for ${gameTitle} — browse cards, relics, potions, characters, monsters, events, and more.`}>
  <div class="game-masthead">
    <div>
      <p class="editorial-label">{t('Reference', locale)} / {isSts2 ? 'II' : 'I'}</p>
      <h1>{gameTitle}</h1>
      <p class="game-intro">{t('Cards', locale)} · {t('Relics', locale)} · {t('Game Mechanics', locale)}</p>
    </div>
    <img class="game-frontispiece" src={isSts2 ? '/images/sts2/landing.jpg' : '/images/sts1/banner_sm.jpg'} alt="" width="800" height="450" />
  </div>

  <div class="field-guide">
    <section class="guide-contents" aria-labelledby="browse-heading">
      <div class="section-heading"><h2 id="browse-heading">{t('Browse', locale)}</h2><span aria-hidden="true">{isSts2 ? 'II' : 'I'}</span></div>
      <div class="catalogue-grid">
        {browseLinks.map((item) => (
          <a href={`${langPrefix}/${game}/${item.path}`} class="catalogue-link">

            <img src={`/images/${game}/nav-normalized/${item.path}.png`} alt="" width="40" height="40" />
            <span class="catalogue-label">{t(item.label, locale)}<span class="catalogue-count">{item.count.toLocaleString(locale)} {locale === 'en' ? item.label.toLowerCase() : t(item.label, locale)}</span></span>
            <span class="link-arrow" aria-hidden="true">→</span>
          </a>
        ))}
      </div>
      <div class="guide-notes">
        <a href={`${langPrefix}/${game}/reference`}>{t('Reference', locale)} <span aria-hidden="true">→</span></a>
        {isSts2 && <a href={`${langPrefix}/${game}/changelog`}>{t('Patch Notes', locale)} <span aria-hidden="true">→</span></a>}
      </div>
    </section>

    <section class="guide-characters" aria-labelledby="characters-heading">
      <div class="section-heading"><h2 id="characters-heading">{t('Characters', locale)}</h2><span>{data.characters.length}</span></div>
      <div class="character-index">
        {data.characters.map((ch) => (
          <a href={`${langPrefix}/${game}/characters/${ch.id}`} class="character-entry">
            <img src={`/images/${game}/characters/${portraitMap[ch.id] ?? ch.id.toLowerCase()}.jpg`} alt="" width="100" height="76" style={`object-position: ${positionMap[ch.id] ?? 'center 30%'}`} />
            <span><span class="character-name">{ch.name}</span><span class="character-description">{taglineMap[ch.id] ?? ''}</span></span>
            <span class="link-arrow" aria-hidden="true">→</span>
          </a>
        ))}
      </div>
    </section>
  </div>
</Layout>
